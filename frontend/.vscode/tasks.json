			"command": "node node_modules/typescript/bin/tsc --noEmit"
		},
		{
			"label": "frontend-tsc",
			"type": "shell",
			"command": "node .\\node_modules\\typescript\\bin\\tsc --noEmit"
		},
		{
			"label": "tsc-check",
			"type": "shell",
			"command": "node node_modules/typescript/bin/tsc --noEmit; echo EXIT:$LASTEXITCODE"
