DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/fitness
BOT_TOKEN=replace_with_telegram_bot_token
BOT_USERNAME=fil_fit_bot
# Public HTTPS front (ngrok or prod). Menu Button Open + /start web_app button.
MINI_APP_URL=https://your-ngrok-or-domain.example
# Admin Mini App CRUD: Telegram usernames (no @) and/or numeric IDs
ADMIN_TELEGRAM_USERNAMES=Filatov_Slava
ADMIN_TELEGRAM_IDS=
# Optional: must match setWebhook secret_token
TELEGRAM_WEBHOOK_SECRET=
# ngrok authtoken (never commit real value). Used by scripts/dev.ps1 Start-Ngrok.
NGROK_AUTHTOKEN=
JWT_SECRET=replace_with_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
# Optional SMTP for email OTP (web login). Without SMTP, codes go to Telegram if account linked.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Comma-separated. TZ §8: https://web.telegram.org + custom app domain
CORS_ORIGINS=https://web.telegram.org,http://localhost:5173
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=
LLM_API_KEY=
LLM_BASE_URL=
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
SENTRY_DSN=
# Daily logs under <repo>/logs (api-YYYY-MM-DD.log). Optional override:
# LOG_DIR=C:\fitness_prog\logs
LOG_DIR=
# Keep zipped day logs in logs/archive/ for N days
LOG_ARCHIVE_DAYS=30