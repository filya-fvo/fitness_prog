DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/fitness
BOT_TOKEN=replace_with_telegram_bot_token
BOT_USERNAME=fil_fit_bot
# Optional public OIDC client id from BotFather Login Widget.
# Empty = derive the numeric bot id from BOT_TOKEN.
TELEGRAM_LOGIN_CLIENT_ID=
# Public HTTPS front (local Tailscale or permanent production host).
MINI_APP_URL=https://your-machine.your-tailnet.ts.net
# Public API host for webhook-mode diagnostics/recovery; local mode may leave it empty.
API_DOMAIN=
# Admin Mini App CRUD: Telegram usernames (no @) and/or numeric IDs
ADMIN_TELEGRAM_USERNAMES=Filatov_Slava
ADMIN_TELEGRAM_IDS=
ADMIN_SMOKE_TELEGRAM_ID=
ADMIN_SYSTEM_STATUS_DIR=
# Required in production; must match setWebhook secret_token
TELEGRAM_WEBHOOK_SECRET=
# webhook for local HTTPS; production Compose overrides this to polling
TELEGRAM_UPDATE_MODE=webhook
JWT_SECRET=replace_with_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
# Comma-separated. TZ §8: https://web.telegram.org + custom app domain
CORS_ORIGINS=https://web.telegram.org,http://localhost:5173
# Browser Web Push. Generate one key pair; keep the private key secret.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
LLM_PROVIDER=local
LLM_API_KEY=
LLM_BASE_URL=http://llm:8080/v1
LLM_MODEL=qwen2.5-3b-instruct
LLM_TIMEOUT_SECONDS=75
LLM_MAX_OUTPUT_TOKENS=320
OCR_BASE_URL=http://ocr:8090
OCR_TIMEOUT_SECONDS=35
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
SENTRY_DSN=
# Daily logs under <repo>/logs (api-YYYY-MM-DD.log). Optional override:
# LOG_DIR=C:\fitness_prog\logs
LOG_DIR=
# Keep zipped day logs in logs/archive/ for N days
LOG_ARCHIVE_DAYS=30

# --- Email OTP login (browser outside Telegram) ---
# Sender mailbox (Mail.ru). Use app password if 2FA is on.
SMTP_FROM_EMAIL=fil_fit_bot@mail.ru
SMTP_FROM_NAME=Fitness Trainer
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USERNAME=fil_fit_bot@mail.ru
SMTP_PASSWORD=
SMTP_USE_SSL=true
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_LENGTH=6
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_IP_HOURLY_LIMIT=20
# When SMTP_PASSWORD empty and ENVIRONMENT!=production, API may return dev_code
EMAIL_OTP_DEV_RETURN_CODE=true
