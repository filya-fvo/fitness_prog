# Copy to backend/.env.production (never commit real secrets)
# docker compose / Render / Railway / VPS

ENVIRONMENT=production

# VPS domains: create A records for both names pointing to the server IPv4.
APP_DOMAIN=app.example.ru
API_DOMAIN=api.example.ru
ACME_EMAIL=admin@example.ru
MINI_APP_URL=https://app.example.ru
VITE_API_URL=https://api.example.ru
VITE_BOT_USERNAME=fil_fit_bot

# Docker PostgreSQL. Generate a URL-safe hex password: openssl rand -hex 24
POSTGRES_USER=fitness
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_HEX
POSTGRES_DB=fitness
DATABASE_URL=postgresql+asyncpg://fitness:CHANGE_ME_URL_SAFE_HEX@db:5432/fitness

BOT_TOKEN=123456:REPLACE_TELEGRAM_BOT_TOKEN
BOT_USERNAME=fil_fit_bot
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

# openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_32PLUS
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# Comma-separated exact origins (no trailing slash)
# Include Telegram Web + your production Mini App domain
CORS_ORIGINS=https://web.telegram.org,https://app.example.ru

REDIS_URL=redis://redis:6379/0
# Upstash example:
# REDIS_URL=rediss://default:PASSWORD@HOST:6379

SENTRY_DSN=
# The API and notification worker must use the same VAPID key pair.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
LLM_PROVIDER=local
LLM_API_KEY=
LLM_BASE_URL=http://llm:8080/v1
LLM_MODEL=qwen2.5-3b-instruct
LLM_TIMEOUT_SECONDS=75
LLM_MAX_OUTPUT_TOKENS=320
OCR_BASE_URL=http://ocr:8090
OCR_TIMEOUT_SECONDS=35
LOCAL_AI_MODELS_DIR=/opt/fitness/models

# SMTP is used for browser login codes and feedback delivery.
SMTP_FROM_EMAIL=fil_fit_bot@mail.ru
SMTP_FROM_NAME=Fil Fit
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USERNAME=fil_fit_bot@mail.ru
SMTP_PASSWORD=
SMTP_USE_SSL=true

# Browser email OTP abuse protection
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_LENGTH=6
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_IP_HOURLY_LIMIT=20
# Never expose a plaintext OTP in a production API response, even if SMTP is broken.
EMAIL_OTP_DEV_RETURN_CODE=false

# Browser and Telegram feedback delivery (uses the SMTP settings from deployment)
ADMIN_FEEDBACK_EMAIL=
FEEDBACK_HOURLY_LIMIT=8

# Admin access and operational logs
ADMIN_TELEGRAM_USERNAMES=
ADMIN_TELEGRAM_IDS=
# Dedicated test account. Used only by smoke_telegram_delivery.py --write.
ADMIN_SMOKE_TELEGRAM_ID=
ADMIN_SYSTEM_STATUS_DIR=/app/host-status
LOG_DIR=/app/logs
LOG_ARCHIVE_DAYS=30
