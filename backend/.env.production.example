# Copy to backend/.env.production (never commit real secrets)
# docker compose / Render / Railway / VPS

ENVIRONMENT=production

# Prefer pooler URL on Supabase; use sslmode=require when required by host
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/fitness

BOT_TOKEN=123456:REPLACE_TELEGRAM_BOT_TOKEN
BOT_USERNAME=fil_fit_bot
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

# openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_32PLUS
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# Comma-separated exact origins (no trailing slash)
# Include Telegram Web + your production Mini App domain
CORS_ORIGINS=https://web.telegram.org,https://app.example.com

REDIS_URL=redis://redis:6379/0
# Upstash example:
# REDIS_URL=rediss://default:PASSWORD@HOST:6379

SENTRY_DSN=
# The API and notification worker must use the same VAPID key pair.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.6-27b
LLM_FALLBACK_MODELS=
NUTRITION_VISION_MODEL=qwen/qwen3.6-27b
AI_DAILY_LIMIT=10

# SMTP is used for browser login codes and feedback delivery.
SMTP_FROM_EMAIL=fil_fit_bot@mail.ru
SMTP_FROM_NAME=Fil Fit
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USERNAME=fil_fit_bot@mail.ru
SMTP_PASSWORD=
SMTP_USE_SSL=true

# Browser email OTP abuse protection
EMAIL_OTP_IP_HOURLY_LIMIT=20

# Browser and Telegram feedback delivery (uses the SMTP settings from deployment)
ADMIN_FEEDBACK_EMAIL=
FEEDBACK_HOURLY_LIMIT=8

# Optional later (not required v1 — external YouTube/URLs only)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=
