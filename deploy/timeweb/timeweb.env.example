# Public application settings
ENVIRONMENT=production
MINI_APP_URL=https://app.filfitclub.ru
CORS_ORIGINS=https://web.telegram.org,https://app.filfitclub.ru
EMAIL_OTP_DEV_RETURN_CODE=false

# Timeweb DBaaS. URL-encode special characters in passwords.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@PRIVATE_POSTGRES_HOST:5432/DATABASE
REDIS_URL=rediss://USER:PASSWORD@VALKEY_HOST:PORT/0

# Required secrets: set only in Timeweb App Platform, never in GitHub or files.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
BOT_TOKEN=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_VALUE

# Telegram/admin
BOT_USERNAME=CHANGE_ME_WITHOUT_AT
ADMIN_TELEGRAM_USERNAMES=
ADMIN_TELEGRAM_IDS=

# Groq AI (optional)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.6-27b
LLM_FALLBACK_MODELS=
NUTRITION_VISION_MODEL=qwen/qwen3.6-27b
AI_DAILY_LIMIT=10

# Browser email login and feedback (optional)
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Fil Fit
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
ADMIN_FEEDBACK_EMAIL=

# Web Push / diagnostics (optional)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
SENTRY_DSN=
