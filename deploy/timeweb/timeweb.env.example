# One public origin for the Mini App, API and Telegram webhook.
ENVIRONMENT=production
MINI_APP_URL=https://app.filfitclub.ru
CORS_ORIGINS=https://web.telegram.org,https://app.filfitclub.ru
EMAIL_OTP_DEV_RETURN_CODE=false

# Timeweb DBaaS public endpoints with protected connections enabled.
# Copy the exact hosts and ports from the Timeweb panel. URL-encode passwords.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@PUBLIC_POSTGRES_HOST:PORT/DATABASE?ssl=require
REDIS_URL=rediss://USER:PASSWORD@PUBLIC_VALKEY_HOST:PORT/0

# Required secrets: set only in Timeweb App Platform, never in GitHub or files.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
BOT_TOKEN=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_VALUE

# Telegram/admin
BOT_USERNAME=CHANGE_ME_WITHOUT_AT
ADMIN_TELEGRAM_USERNAMES=
ADMIN_TELEGRAM_IDS=

# Local AI is available only in the VPS Docker Compose stack.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_BASE_URL=http://llm:8080/v1
LLM_MODEL=qwen2.5-1.5b-instruct
LLM_TIMEOUT_SECONDS=75
LLM_MAX_OUTPUT_TOKENS=320
OCR_BASE_URL=http://ocr:8090
OCR_TIMEOUT_SECONDS=35
LOCAL_AI_MODELS_DIR=/opt/fitness/models

# Browser email login and feedback (optional)
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Fil Fit
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
ADMIN_FEEDBACK_EMAIL=

# Web Push / diagnostics (optional)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
SENTRY_DSN=
